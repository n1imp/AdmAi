# ── Dependências ──────────────────────────────────────────────
node_modules/

# ── Variáveis de ambiente (NUNCA versionar segredos) ──────────
.env
.env.*
!.env.example
!.env.test.example
!.env.staging.example

# ── Chaves / segredos (NUNCA versionar) ───────────────────────
# Chaves SSH, certificados e similares — mantenha sempre fora do repo.
id_rsa
id_ed25519
ssh-*
*.pem
*.key
*_rsa
*_ed25519
*.ppk

# ── Builds / artefatos ────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── WhatsApp / estado de sessão (Baileys) ─────────────────────
auth_info/
chaveiro-bot/auth_info/

# ── Uploads de mídia gerados em runtime ───────────────────────
uploads/
chaveiro-bot/uploads/
# Selfies de ponto (biometria/PII LGPD): diretório PRIVADO, servido só via API autenticada
uploads-ponto/
chaveiro-bot/uploads-ponto/
# Documentos do funcionário (PII/LGPD): diretório PRIVADO, servido só via API autenticada
uploads-docs/
chaveiro-bot/uploads-docs/

# ── Bancos / vetores locais ───────────────────────────────────
*.db
*.db-journal
*.rvf
*.rvf.lock

# ── Supabase CLI (cache/temp local; contém project-ref/pooler-url) ─────
**/supabase/.temp/
**/supabase/.branches/

# ── Config local de ferramenta de IA (por maquina, nao versionar) ──
# Poluem o baseline por lane do Write Set Gate (628 arquivos) sem serem parte do
# projeto: `project.yml` da Serena carrega caminho local, `config.toml` do Codex
# carrega preferencia de perfil.
.serena/
.codex/

# ── Ruflo / claude-flow / swarm / tooling de IA (local, não versionar) ──
.swarm/
.claude-flow/
# `.claude/*` (e não `.claude/`) porque o Git não desce em diretório ignorado —
# sem isso, nenhuma exceção abaixo funcionaria.
.claude/*
# Exceção estreita: o roteador de ferramentas é configuração compartilhável do
# projeto (sem segredo, sem caminho pessoal) e precisa ser reproduzível em outra
# worktree. Mesmo princípio que já mantém CLAUDE.md e AGENTS.md rastreados.
# Tudo o mais em `.claude/` continua ignorado: perfil, launcher, hashes e locks.
!.claude/skills/
.claude/skills/*
!.claude/skills/admai-tool-router/
claude/
.mcp.json
CLAUDE.md

# ── Logs ──────────────────────────────────────────────────────
*.log
build_*.log
npm-debug.log*

# ── Sistema operacional / editor ──────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Coverage de testes ────────────────────────────────────────
coverage/

# ── Quarentena (revisão manual antes de apagar de vez) ────────
_quarentena/

# Saida de captura do inventario de release: evidencia, nao fonte.
# Fica fora do diff para que rodar a observacao nao produza escrita nao declarada.
chaveiro-painel/telas/
