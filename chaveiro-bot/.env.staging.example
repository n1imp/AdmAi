# =============================================================================
# .env.staging.example — validação do Prisma 7 (driver adapter + pooler) em STAGING
# =============================================================================
# COPIE para `.env.staging` e preencha. O `.env.staging` real é IGNORADO pelo git
# (contém a senha do banco). NUNCA cole a senha no chat — este arquivo é a via.
#
# ⚠️ USE UM PROJETO SUPABASE **DEDICADO A STAGING** — NÃO o AdmAi de produção.
#    Rodar `prisma migrate deploy` recria/altera o schema; jamais aponte para prod.
#    (org n1imp: AdmAi=PROD. Crie um projeto novo só para staging.)
#
# Onde achar as strings no dashboard Supabase do projeto de STAGING:
#   Project Settings → Database → Connection string
#     • "Direct connection" (host db.<ref>.supabase.co, porta 5432)  → DIRECT_URL
#     • "Transaction pooler" (host ...pooler.supabase.com, porta 6543) → DATABASE_URL
#   (No pooler o usuário é `postgres.<ref>`; na direta é `postgres`.)
# =============================================================================

# -- Ambiente de APLICAÇÃO (STG-APP-STAGING-01, D1 01a038e5) -------------------
# APP_ENV é ORTOGONAL a NODE_ENV: o runtime de staging roda NODE_ENV=production
# (comportamento seguro/perf de prod, guards de prod ATIVOS) + APP_ENV=staging
# (liga o anti-production guard fail-closed no boot: vínculo positivo de TODAS as
# conexões ao ref de staging + origens exatas; ver src/config/env.js).
APP_ENV=staging

# -- Trava de segurança (o script recusa rodar sem isto) ----------------------
# Confirmação explícita de que este NÃO é o banco de produção:
ALLOW_STAGING_WRITES=false
# ALLOWLIST POSITIVA: o ref do projeto de STAGING (o `postgres.<ref>` das URLs abaixo).
# O script exige que AS DUAS URLs contenham este ref — prod jamais casaria. É o guard
# principal, porque staging e prod dividem o MESMO host de pooler (só o ref difere).
# Com APP_ENV=staging, o BOOT do app também exige exatamente qsuufuulxfkkeasgxhcv.
STAGING_REF=qsuufuulxfkkeasgxhcv
# BLOCKLIST NEGATIVA (opcional, defesa extra): o REF do projeto de PRODUÇÃO (NÃO o host do
# pooler, que é compartilhado). O script ABORTA se qualquer URL contiver este ref.
# (O boot com APP_ENV=staging já nega SEMPRE o ref de produção conhecido, com ou sem isto.)
PROD_HOST_BLOCKLIST=disljhkypaxpyzvbooge
# Sinônimo lido pelo guard de BOOT (mantém as duas travas alinhadas):
PROD_REF_BLOCKLIST=disljhkypaxpyzvbooge

# -- Conexões (staging) -------------------------------------------------------
# Copie EXATAMENTE do dashboard (Connect → ORM → Prisma). O prefixo `aws-N` varia por
# projeto (ex.: aws-1-sa-east-1) — não invente, copie.
# RUNTIME (o que valida o Prisma 7): POOLER transaction mode, porta 6543.
DATABASE_URL=postgresql://postgres.SEU_REF_STAGING:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# MIGRATIONS: POOLER session mode, porta 5432 (segura os locks das migrations; é a que o
# Supabase indica p/ o `directUrl` do Prisma no free plan — IPv4). NÃO use a 6543 aqui.
DIRECT_URL=postgresql://postgres.SEU_REF_STAGING:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# -- Mínimo para o app/testes subirem (Zod valida no boot) --------------------
# [REVISOR 01a038fc achado 4] SEM valores copiáveis: exemplo com secret "de mentira"
# vira secret real por preguiça. Gere os SEUS e nunca reutilize os de produção.
# NODE_ENV: 'test' para rodar validate-staging/integração desta máquina;
# no RUNTIME Railway staging é 'production' (ver ADMAI_APPLICATION_STAGING_DEPLOY_PACKAGE).
NODE_ENV=test
# Gere: openssl rand -hex 32   (um valor NOVO por ambiente; nunca o de produção)
API_TOKEN=
# JWT_SECRET: mínimo 32 chars. Gere: openssl rand -hex 32
JWT_SECRET=
# ENCRYPTION_KEY: mínimo 16 chars (cifra tokens/OTP). Gere: openssl rand -hex 32
ENCRYPTION_KEY=
# Bootstrap opcional (só roda se o banco estiver vazio) — deixe vazio em staging
# (as contas vêm do seed-staging.mjs, sintéticas e removíveis):
ADMIN_USERNAME=
ADMIN_PASSWORD=

# -- Runtime de APLICAÇÃO staging (backend Railway staging) --------------------
# Exigidas pelo guard de boot com APP_ENV=staging (igualdade EXATA de origem;
# credenciais atravessam o CORS, então nunca '*'):
SUPABASE_URL=https://qsuufuulxfkkeasgxhcv.supabase.co
# service-role do admai-staging (Storage server-side). NUNCA a de produção.
SUPABASE_SERVICE_ROLE_KEY=
# Vínculo positivo dos scripts de Storage (provision/smoke): com isto definido, eles
# ABORTAM se a SUPABASE_URL não for exatamente a do admai-staging [REVISOR 01a038fc]:
REQUIRE_SUPABASE_REF=qsuufuulxfkkeasgxhcv
# Origem EXATA do painel staging (branch preview fixa do projeto admai-painel):
ALLOWED_ORIGIN=https://staging.admai-painel.pages.dev
# Links de email apontam para o painel staging (mesma origem do ALLOWED_ORIGIN):
FRONTEND_URL=https://staging.admai-painel.pages.dev
# URL pública do PRÓPRIO backend staging (preencher após o Railway criar o domínio):
PUBLIC_URL=
# Uploads NÃO podem cair no disco atrás do CDN — storage obrigatório em staging:
STORAGE_STRICT=true

# -- Fase 2 (RLS) — deixe off até validar o Prisma 7 puro primeiro ------------
# Ligue só depois de aplicar prisma/rls/enable_rls.sql em staging (ver runbook).
RLS_ENABLED=false
