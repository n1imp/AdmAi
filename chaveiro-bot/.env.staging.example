# =============================================================================
# .env.staging.example — validação do Prisma 7 (driver adapter + pooler) em STAGING
# =============================================================================
# COPIE para `.env.staging` e preencha. O `.env.staging` real é IGNORADO pelo git
# (contém a senha do banco). NUNCA cole a senha no chat — este arquivo é a via.
#
# ⚠️ USE UM PROJETO SUPABASE **DEDICADO A STAGING** — NÃO o AdmAi de produção.
#    Rodar `prisma migrate deploy` recria/altera o schema; jamais aponte para prod.
#    (org n1imp: AdmAi=PROD. Crie um projeto novo só para staging.)
#
# Onde achar as strings no dashboard Supabase do projeto de STAGING:
#   Project Settings → Database → Connection string
#     • "Direct connection" (host db.<ref>.supabase.co, porta 5432)  → DIRECT_URL
#     • "Transaction pooler" (host ...pooler.supabase.com, porta 6543) → DATABASE_URL
#   (No pooler o usuário é `postgres.<ref>`; na direta é `postgres`.)
# =============================================================================

# -- Trava de segurança (o script recusa rodar sem isto) ----------------------
# Confirmação explícita de que este NÃO é o banco de produção:
ALLOW_STAGING_WRITES=false
# ALLOWLIST POSITIVA: o ref do projeto de STAGING (o `postgres.<ref>` das URLs abaixo).
# O script exige que AS DUAS URLs contenham este ref — prod jamais casaria. É o guard
# principal, porque staging e prod dividem o MESMO host de pooler (só o ref difere).
STAGING_REF=SEU_REF_STAGING
# BLOCKLIST NEGATIVA (opcional, defesa extra): o REF do projeto de PRODUÇÃO (NÃO o host do
# pooler, que é compartilhado). O script ABORTA se qualquer URL contiver este ref.
PROD_HOST_BLOCKLIST=

# -- Conexões (staging) -------------------------------------------------------
# Copie EXATAMENTE do dashboard (Connect → ORM → Prisma). O prefixo `aws-N` varia por
# projeto (ex.: aws-1-sa-east-1) — não invente, copie.
# RUNTIME (o que valida o Prisma 7): POOLER transaction mode, porta 6543.
DATABASE_URL=postgresql://postgres.SEU_REF_STAGING:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# MIGRATIONS: POOLER session mode, porta 5432 (segura os locks das migrations; é a que o
# Supabase indica p/ o `directUrl` do Prisma no free plan — IPv4). NÃO use a 6543 aqui.
DIRECT_URL=postgresql://postgres.SEU_REF_STAGING:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# -- Mínimo para o app/testes subirem (Zod valida no boot) --------------------
NODE_ENV=test
API_TOKEN=staging-api-token
# JWT_SECRET: mínimo 32 chars. Gere: openssl rand -hex 32
JWT_SECRET=0123456789012345678901234567890123456789
# ENCRYPTION_KEY: mínimo 16 chars (cifra tokens/OTP). Gere: openssl rand -hex 32
ENCRYPTION_KEY=stagingstagingstagingstaging0123
# Bootstrap opcional (só roda se o banco estiver vazio):
ADMIN_USERNAME=stagingadmin
ADMIN_PASSWORD=staging-admin-pass

# -- Fase 2 (RLS) — deixe off até validar o Prisma 7 puro primeiro ------------
# Ligue só depois de aplicar prisma/rls/enable_rls.sql em staging (ver runbook).
RLS_ENABLED=false
