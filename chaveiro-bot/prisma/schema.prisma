// ⚠️ NOTA (directUrl x SQLite de dev): o `directUrl` no datasource abaixo é só para
// Postgres (pooler do Supabase). Se você REGERAR o schema SQLite de dev a partir
// deste arquivo (ex.: o sed que cria prisma/schema.sqlite.prisma), REMOVA manualmente
// a linha `directUrl` de lá — o SQLite não a suporta e o `db push` falha.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: a conexão NÃO fica mais no schema. O runtime usa o driver adapter
  // (@prisma/adapter-pg com DATABASE_URL — pooler pgbouncer 6543) em src/db/prisma.js;
  // as migrations usam DIRECT_URL (5432) via prisma.config.ts.
  // ⚠️ VALIDAR contra Supabase (pooler transaction mode) antes de merge/deploy.
}

// ── MULTI-TENANT ──────────────────────────────────────────────────────────────
// Cada empresa é um tenant isolado. Todos os dados de negócio são escopados por
// empresaId; o isolamento é garantido no client Prisma estendido (src/db/tenant.js).
model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  slug      String   @unique
  ativo     Boolean  @default(true)
  // Quando true, serviços registrados por funcionários entram como "pendente" e só
  // contam (comissão/estoque) após aprovação do dono/gestor. Toggle por empresa.
  aprovacaoServico Boolean @default(false)
  whatsapp   EmpresaWhatsapp?
  usuarios   Usuario[]
  tecnicos   Tecnico[]
  servicos   Servico[]
  materiais  Material[]
  pagamentos Pagamento[]
  documentos DocumentoTecnico[]
  assinatura Assinatura?
  criadoEm   DateTime @default(now())
}

// Configurações de WhatsApp POR EMPRESA (settings do robô de número único + Cloud API).
// A CONEXÃO em si (instância/QR/estado) vive no singleton ConexaoBot — aqui ficam apenas
// o grupo de resumo, os parâmetros de avaliação e as credenciais da Cloud API (Meta).
model EmpresaWhatsapp {
  id               Int      @id @default(autoincrement())
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId        Int      @unique
  grupoJid         String?            // grupo que recebe o resumo do serviço
  reviewDelayHoras Int      @default(2)   // atraso (h) para pedir avaliação ao cliente
  reviewLink       String?            // link de avaliação da empresa (Google, site, etc.)
  reviewAtivo      Boolean  @default(true) // liga/desliga o envio automático da solicitação
  reviewTemplate   String?            // template da mensagem de solicitação (null = padrão)
  // ── WhatsApp Cloud API (Meta) — usados quando provider='cloud' ─────────────
  // provider seleciona a camada de WhatsApp desta empresa. 'evolution' (não-oficial,
  // QR/instância) é o padrão atual; 'cloud' usa a API oficial da Meta (sem QR).
  provider         String   @default("evolution") // 'evolution' | 'cloud'
  phoneNumberId    String?            // ID do número na Cloud API (destino do /messages)
  wabaId           String?            // WhatsApp Business Account ID
  accessTokenEnc   String?            // token de acesso (System User), cifrado em repouso
  atualizadoEm     DateTime @updatedAt
}

model Tecnico {
  id              Int         @id @default(autoincrement())
  empresa         Empresa     @relation(fields: [empresaId], references: [id])
  empresaId       Int
  nome            String
  telefone        String?     // identificador interno WhatsApp (pode ser LID ou número real)
  telefoneDisplay String?              // número de telefone para exibição no painel
  comissao        Float       @default(0)  // percentual: 10.0 = 10%
  metaMensal      Float?               // meta de receita líquida do mês (R$); null = sem meta
  fotoPerfil      String?     // URL da foto de perfil do WhatsApp
  ativo           Boolean     @default(true)
  // Liga o "técnico do dono" ao Usuario que o criou (no cadastro). null = funcionário comum.
  usuarioId       Int?        @unique
  usuario         Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  // ── Dados de RH (cadastro em etapas) ──────────────────────────────────────
  cpf                 String?
  dataNascimento      DateTime?
  endereco            String?
  nivelAcesso         String?   // papel no painel (ex.: "tecnico" | "gestor")
  // Vínculo contratual: "clt" | "clt_meio" | "clt_12x36" | "intermitente" | "autonomo"
  modalidade          String?
  salarioBase         Float?
  dataAdmissao        DateTime?
  horaExtraAtiva      Boolean   @default(false)
  horaExtraPercentual Float?    // % sobre a hora normal (ex.: 50 = +50%)
  adicionalNoturno    Boolean   @default(false)
  valorHora           Float?    // usado na modalidade intermitente
  jornadaDiariaMin    Int?      // jornada contratual do dia em minutos (default por modalidade)
  jornadaSemanalMin   Int?      // jornada contratual semanal em minutos
  servicos        Servico[]
  pagamentos      Pagamento[]
  pontos          RegistroPonto[]
  documentos      DocumentoTecnico[]
  criadoEm       DateTime    @default(now())

  // telefone é único POR EMPRESA (o mesmo número pode existir em empresas diferentes)
  @@unique([empresaId, telefone])
  @@index([empresaId])
  // Lookup GLOBAL por telefone — o robô de número único resolve a empresa pelo remetente.
  @@index([telefone])
}

// Documentos do técnico (contrato, RG, CNH…) — F9/M4, atrás da flag DOCUMENTOS_ENABLED.
// Armazenados em bucket PRIVADO (Supabase Storage) com URL assinada curta; o painel do
// funcionário gerencia só os PRÓPRIOS documentos (capacidade RBAC proprio.documentos).
// Escopado por empresaId (tenant) — ver src/db/tenant.js e prisma/rls/enable_rls.sql.
model DocumentoTecnico {
  id         Int      @id @default(autoincrement())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  Int
  tecnico    Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  tecnicoId  Int
  tipo       String   // categoria: contrato | rg | cpf | cnh | comprovante | outro
  nome       String   // nome de exibição (do arquivo enviado)
  mime       String   // application/pdf | image/jpeg | image/png
  tamanho    Int      // bytes
  storageKey String   // objeto no bucket privado (ou nome do arquivo no disco em dev/test)
  criadoEm   DateTime @default(now())

  @@index([empresaId, tecnicoId])
}

model Servico {
  id             Int               @id @default(autoincrement())
  empresa        Empresa           @relation(fields: [empresaId], references: [id])
  empresaId      Int
  tecnico        Tecnico           @relation(fields: [tecnicoId], references: [id])
  tecnicoId      Int
  local          String
  endereco       String?
  descricao      String
  material       String?           // descrição textual do material
  valorCobrado   Float
  valorMaterial  Float             @default(0)
  valorLiquido   Float             // calculado automaticamente: cobrado - material
  comissaoGerada Float             @default(0)  // valorLiquido * (comissao / 100)
  // Taxa VIGENTE quando a comissão foi computada. `comissaoGerada` grava o valor; a taxa era
  // irreconstituível (toFixed(2) + Float: líquido 1,01 a 5% grava 0,05 e a divisão devolve
  // 4,95%; líquido zero nem divide). Nullable: histórico fica NULL — lacuna honesta.
  comissaoTaxaAplicada Float?       // snapshot imutável [FIX-COMISSAO-SNAPSHOT]
  fotoEvidencia  String?           // caminho/URL da foto enviada junto ao serviço (prova visual)
  // Cliente atendido — usado para enviar a solicitação de avaliação após a conclusão
  clienteNome    String?
  clienteTelefone String?
  msgOriginal    String
  remetenteWpp   String
  // Fluxo de aprovação: "ativo" (conta normalmente) | "pendente" (aguarda dono/gestor) |
  // "rejeitado". Serviços "pendente"/"rejeitado" NÃO geram comissão nem baixam estoque.
  // F9/M3 (flag SERVICO_ANDAMENTO_ENABLED): "em_andamento" é um estado transitório do
  // "serviço atual" do técnico — não conta em dashboards até concluir (volta a "ativo").
  status         String            @default("ativo")
  aprovadoPor    Int?              // Usuario que aprovou (auditoria)
  aprovadoEm     DateTime?
  // F9/M3 — marcas do serviço em execução ("serviço atual"). Nulas por padrão; aditivas.
  iniciadoEm     DateTime?
  finalizadoEm   DateTime?
  materiais      ServicoMaterial[]
  movimentacoes  MovimentacaoEstoque[]
  criadoEm      DateTime          @default(now())

  @@index([empresaId])
  @@index([empresaId, criadoEm])
  @@index([empresaId, status])
  @@index([tecnicoId])
  // F9/M3 — busca do "serviço atual" (status em_andamento) por técnico.
  @@index([tecnicoId, status])
  @@index([local])
  @@index([endereco])
  @@index([clienteTelefone])
  // Índice já existente no banco (migrations) — declarado aqui para o schema não driftar.
  // Redundante com [empresaId, criadoEm]; pode ser removido numa limpeza futura.
  @@index([criadoEm])
}

// Banco central de materiais — catálogo + controle de estoque com saldo real
model Material {
  id              Int                   @id @default(autoincrement())
  empresa         Empresa               @relation(fields: [empresaId], references: [id])
  empresaId       Int
  nome            String
  descricao       String?               // descrição do produto/material
  imagemUrl       String?               // URL/foto do produto
  unidade         String                @default("un")  // un, m, kg, l, etc.
  precoUnit       Float?                // custo de compra (entrada)
  precoVenda      Float?                // preço cobrado ao cliente
  estoqueMinimo   Float?                // gatilho de alerta de reposição
  quantidadeAtual Float                 @default(0)  // saldo real em estoque
  servicos        ServicoMaterial[]
  movimentacoes   MovimentacaoEstoque[]
  criadoEm       DateTime              @default(now())

  // nome é único POR EMPRESA
  @@unique([empresaId, nome])
  @@index([empresaId])
}

// Histórico de movimentações de estoque (entrada manual / saída por serviço / ajuste)
model MovimentacaoEstoque {
  id          Int       @id @default(autoincrement())
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId  Int
  tipo        String    // "entrada" | "saida" | "ajuste"
  quantidade  Float     // sempre positiva; o sinal é dado pelo tipo
  saldoApos   Float     // saldo do material logo após esta movimentação (auditoria)
  origem      String?   // "manual" | "servico" | "ajuste"
  servico     Servico?  @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  servicoId   Int?
  observacao  String?
  criadoEm   DateTime  @default(now())

  @@index([materialId])
}

// Relacionamento serviço ↔ material com quantidade
model ServicoMaterial {
  id         Int      @id @default(autoincrement())
  servico    Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  servicoId  Int
  material   Material @relation(fields: [materialId], references: [id])
  materialId Int
  quantidade Float    @default(1)
  descricao  String?

  @@unique([servicoId, materialId])
}

model Usuario {
  id                  Int       @id @default(autoincrement())
  empresa             Empresa   @relation(fields: [empresaId], references: [id])
  empresaId           Int
  nome                String
  username            String    @unique
  email               String?   @unique
  telefone            String?   @unique
  senhaHash           String?   // null em contas só de login social
  admin               Boolean   @default(false)  // legado/compat: equivale a papel == "dono"
  // ── RBAC do painel ────────────────────────────────────────────────────────
  // papel: "dono" (acesso total) | "gestor" (operação) | "funcionario" (só o próprio).
  papel               String    @default("funcionario")
  // Overrides granulares sobre o preset do papel: { modulo: { acao: bool }, proprio: {...} }.
  // null = usa o preset puro do papel (ver services/permissoes.js).
  permissoes          Json?
  // F9/M5 — preferências de UI por usuário (cross-device). Namespaced por área, ex.:
  // { dashboard: { ordem: string[], ocultos: string[] } }. null = usa os defaults do painel.
  preferencias        Json?
  // PIN inicial entregue pelo dono: enquanto true, força troca de senha no 1º acesso.
  senhaProvisoria     Boolean   @default(false)
  ativo               Boolean   @default(true)
  // Verificação
  emailVerificado     Boolean   @default(false)
  telefoneVerificado  Boolean   @default(false)
  // 2FA TOTP (app autenticador)
  twoFactorAtivo      Boolean   @default(false)
  twoFactorSecret     String?   // legado (flag booleano antigo)
  totpSecret          String?   // segredo TOTP confirmado (cifrado em repouso)
  totpPendente        String?   // segredo TOTP aguardando confirmação
  // 2FA / verificação por TELEFONE (OTP via WhatsApp do robô)
  phone2faAtivo       Boolean   @default(false)
  telefoneOtpHash     String?   // OTP do telefone cifrado em repouso
  telefoneOtpExpira   DateTime?
  // Segurança de sessão: tokens emitidos antes desta data são inválidos
  tokenValidoApos     DateTime?
  senhaAlteradaEm     DateTime?
  // Preferências de notificação (toggles liga/desliga). null = usa padrões.
  notificacoes        Json?
  avisos              Notificacao[]
  contasSociais       ContaSocial[]
  tecnico             Tecnico?
  codigosRecuperacao  CodigoRecuperacaoTotp[]
  refreshTokens       RefreshToken[]
  sessoes             SessaoUsuario[]
  criadoEm           DateTime  @default(now())

  @@index([empresaId])
  @@index([telefone])
}

// Conta de login social (OIDC) vinculada a um usuário (Google/Microsoft/Apple).
model ContaSocial {
  id          Int      @id @default(autoincrement())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   Int
  provedor    String   // "google" | "microsoft" | "apple"
  provedorSub String   // claim `sub` estável do provedor
  email       String?
  criadoEm    DateTime @default(now())

  @@unique([provedor, provedorSub])
  @@index([usuarioId])
}

// Central de avisos (inbox) por usuário, com lido/não-lido
model Notificacao {
  id         Int      @id @default(autoincrement())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId  Int
  tipo       String   // "estoque_baixo" | "resumo" | "novo_servico" | "meta" | "sistema"
  titulo     String
  mensagem   String
  link       String?  // rota no painel para onde o aviso leva (ex: /estoque)
  lida       Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId, lida])
  @@index([usuarioId, criadoEm])
}

// Registro de pagamentos de comissão aos técnicos
model Pagamento {
  id         Int      @id @default(autoincrement())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  Int
  tecnico    Tecnico  @relation(fields: [tecnicoId], references: [id])
  tecnicoId  Int
  valor      Float
  descricao  String?
  criadoEm  DateTime @default(now())

  @@index([empresaId])
}

// Sessão de conversa do bot no PRIVADO (fluxo passo a passo de registro de serviço).
// Número único: UMA sessão ATIVA por `jid` (telefone). `empresaId` é nulo durante a
// desambiguação (fluxo "selecao_empresa"), antes de a empresa ser escolhida.
model SessaoConversa {
  id            Int      @id @default(autoincrement())
  empresaId     Int?     // resolvido pelo telefone; nulo durante a desambiguação
  tecnicoId     Int?
  jid           String   // JID/numero do WhatsApp do remetente no privado
  fluxo         String   @default("registro_servico") // "registro_servico" | "selecao_empresa"
  estadoAtual   String   // passo atual da máquina de estados (ex.: "local", "endereco", ...)
  dadosParciais Json     @default("{}") // respostas coletadas até agora
  atualizadoEm  DateTime @updatedAt
  criadoEm      DateTime @default(now())

  @@unique([jid])
  @@index([atualizadoEm])
}

// Avaliação do cliente após a conclusão de um serviço.
// status: "pendente" (agendada) → "enviada" → "respondida" | "expirada"
model Avaliacao {
  id              Int       @id @default(autoincrement())
  empresaId       Int
  servicoId       Int       @unique          // 1 avaliação por serviço
  clienteTelefone String                     // destino (formato 55DDDNUMERO)
  clienteNome     String?
  nota            Int?                        // 1..5, preenchido na resposta
  comentario      String?
  status          String    @default("pendente")
  agendadoPara    DateTime                    // quando a solicitação deve ser enviada
  enviadoEm       DateTime?
  respondidoEm    DateTime?
  criadoEm        DateTime  @default(now())

  @@index([status, agendadoPara])             // varredura eficiente do cron
  @@index([empresaId])
  @@index([clienteTelefone, status])          // achar avaliação pendente de resposta
}

// Conexão ÚNICA do robô (modelo de número único): uma instância global atende todas
// as empresas. Singleton (id sempre = 1).
model ConexaoBot {
  id            Int      @id @default(1)
  instanceName  String?  // nome da instância Evolution global (ex.: "admai-bot")
  estadoConexao String   @default("desconectado")
  qrCode        String?  // data URL/base64 do QR durante o pareamento
  webhookSecret String?  // segredo do webhook global
  numeroDisplay String?  // número do robô (exibição)
  atualizadoEm  DateTime @updatedAt
}

// Registro de PONTO eletrônico do técnico (banco de horas). Um registro por dia por
// técnico. Os horários são SEMPRE o timestamp do servidor no momento em que o bot
// recebe a mensagem "Ponto". Cálculos (totalMinutos, horaExtraMinutos) no backend.
model RegistroPonto {
  id              Int       @id @default(autoincrement())
  empresaId       Int
  tecnico         Tecnico   @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  tecnicoId       Int
  data            DateTime  @db.Date            // dia do ponto (YYYY-MM-DD)
  entradaEm       DateTime?
  almocoSaidaEm   DateTime?
  almocoVoltaEm   DateTime?
  saidaEm         DateTime?
  totalMinutos    Int?      // minutos trabalhados no dia (descontado o almoço)
  horaExtraMinutos Int?     // minutos de hora extra conforme a modalidade
  batidas         BatidaPonto[]
  criadoEm        DateTime  @default(now())

  @@unique([tecnicoId, data])
  @@index([empresaId, data])
}

// Prova de cada BATIDA de ponto (uma por evento do dia). Guarda hora do servidor +
// geolocalização + selfie como evidência anti-fraude. O agregado do dia continua em
// RegistroPonto; aqui ficam as provas individuais (padrão de MovimentacaoEstoque).
model BatidaPonto {
  id         Int           @id @default(autoincrement())
  registro   RegistroPonto @relation(fields: [registroId], references: [id], onDelete: Cascade)
  registroId Int
  tipo       String        // "entrada" | "almoco_saida" | "almoco_volta" | "saida"
  em         DateTime      // timestamp do SERVIDOR no momento da batida
  lat        Float?        // latitude capturada do navegador
  lng        Float?        // longitude capturada do navegador
  precisao   Float?        // precisão do GPS em metros (accuracy)
  selfieUrl  String?       // caminho/URL da selfie de prova (volume de uploads)
  origem     String        @default("painel") // "painel" | "whatsapp"
  criadoEm   DateTime      @default(now())

  @@index([registroId])
}

// Conexão Google Business Profile por empresa (OAuth2). Tokens CIFRADOS em repouso.
// Singleton por empresa (1:1). Usada para listar/responder avaliações do Google.
model GoogleConta {
  id              Int      @id @default(autoincrement())
  empresaId       Int      @unique
  placeId         String?  // ID do local no Google Maps
  accountId       String?  // accounts/{id} da Business Profile API
  locationId      String?  // locations/{id}
  accessTokenEnc  String?  // access token cifrado
  refreshTokenEnc String?  // refresh token cifrado (offline access)
  tokenExpira     DateTime?
  escopo          String?
  conectadoEm     DateTime?
  atualizadoEm    DateTime @updatedAt
}

// Avaliação coletada do Google (Business Profile). reviewId é o id estável do Google.
model AvaliacaoGoogle {
  id              Int       @id @default(autoincrement())
  empresaId       Int
  reviewId        String    @unique
  autorNome       String?
  nota            Int?      // 1..5
  comentario      String?
  criadoEmGoogle  DateTime?
  respondida      Boolean   @default(false)
  respostaTexto   String?
  respondidoEm    DateTime?
  analiseJson     Json?     // sugestão de resposta / temas (IA); null = não analisada
  sincronizadoEm  DateTime  @default(now())

  @@index([empresaId, respondida])
  @@index([empresaId, nota])
}

// Cache do resumo agregado das avaliações por empresa (análise por IA). 1:1 com empresa.
model AnaliseAvaliacoes {
  id                    Int      @id @default(autoincrement())
  empresaId             Int      @unique
  resumoElogios         String?
  resumoCriticas        String?
  ultimoReviewAnalisado String?  // reviewId do último analisado (incremental)
  atualizadoEm          DateTime @updatedAt
}

// Códigos de recuperação TOTP (one-time, bcrypt hash). Gerados ao ativar o 2FA.
model CodigoRecuperacaoTotp {
  id         Int      @id @default(autoincrement())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId  Int
  codigoHash String
  usado      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// Assinatura/plano por empresa (integração Stripe).
model Assinatura {
  id               Int       @id @default(autoincrement())
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  empresaId        Int       @unique
  stripeCustomerId String?   @unique
  stripeSubId      String?   @unique
  stripePriceId    String?
  // trialing | active | past_due | canceled | incomplete
  status           String    @default("trialing")
  trialFimEm       DateTime?
  periodoFimEm     DateTime?
  canceladoEm      DateTime?
  atualizadoEm     DateTime  @updatedAt
  criadoEm         DateTime  @default(now())
}

// Convite por email para entrar numa empresa.
model ConviteUsuario {
  id               Int       @id @default(autoincrement())
  empresaId        Int
  email            String
  papel            String    @default("funcionario")
  tokenHash        String    // bcrypt hash do token enviado por email
  nomeConvidadoPor String?
  aceitoEm         DateTime?
  expiraEm         DateTime
  criadoEm         DateTime  @default(now())

  @@index([empresaId])
  @@index([email, empresaId])
}

// Rastreamento de sessões ativas do painel (para listagem em Segurança → Sessões).
// Cada JWT emitido tem um `iat` único que serve de chave de sessão.
model SessaoUsuario {
  id                Int      @id @default(autoincrement())
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId         Int
  jwtIat            Int      // payload.iat em segundos — ID estável desta sessão
  ip                String?
  userAgent         String?  @db.VarChar(300)
  ultimaAtividadeEm DateTime @updatedAt
  criadoEm          DateTime @default(now())

  @@unique([usuarioId, jwtIat])
  @@index([usuarioId])
}

// Refresh token de sessão (HttpOnly cookie). Hash SHA-256 do token cru.
// Rotacionado a cada uso: delete old → insert new (token rotation).
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// Log de ações privilegiadas (auditoria imutável).
model AuditLog {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  usuarioId  Int?
  acao       String   // notação ponto: "usuario.excluido" | "papel.alterado"
  entidade   String?
  entidadeId Int?
  antes      Json?
  depois     Json?
  ip         String?
  criadoEm  DateTime @default(now())

  @@index([empresaId, criadoEm])
  @@index([usuarioId])
}
