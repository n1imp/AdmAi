{
  "name": "admai-bot",
  "version": "1.0.0",
  "description": "API REST para gestão de serviços AdmAi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.{js,mjs}\"",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:sqlite": "node prisma/sqlite-schema.mjs",
    "validate:staging": "node scripts/validate-staging.mjs",
    "bucket:check": "node --env-file=.env.staging scripts/provision-bucket-documentos.mjs --staging --check",
    "bucket:provision": "node --env-file=.env.staging scripts/provision-bucket-documentos.mjs --staging --provision",
    "bucket:validate": "node --env-file=.env.staging scripts/provision-bucket-documentos.mjs --staging --validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.64.0",
    "@supabase/supabase-js": "^2.110.2",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "otplib": "^13.4.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.18.1",
    "stripe": "^14.0.0",
    "winston": "^3.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
