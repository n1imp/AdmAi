{
  "name": "admai-bot",
  "version": "1.0.0",
  "description": "API REST para gestão de serviços AdmAi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.56.0",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "otplib": "^13.4.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.0.0",
    "prisma": "^5.10.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "winston": "^3.12.0",
    "resend": "^3.0.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
