# -----------------------------------------------------------------------------
# ChaveiroBot - backend (.env)  |  Deploy: Railway (Docker) + Supabase (Postgres)
# Copie para `.env` e preencha. NAO comite o `.env` real.
# Validadas no boot por src/config/env.js (Zod) - o servidor NAO sobe com config
# invalida. Segredos: gere com `openssl rand -hex 32`.
# No Railway, defina estas variaveis no painel do servico (nao sobe arquivo .env).
# -----------------------------------------------------------------------------

# -- Obrigatorias -------------------------------------------------------------
NODE_ENV=production
# PORT: no Railway e injetada automaticamente - NAO defina manualmente la.
# Em dev/local vale 3000.
PORT=3000

# Banco no Supabase: use a CONEXAO DIRETA (Project Settings > Database > Connection
# string > URI, porta 5432). Um container persistente (Railway) usa conexao direta;
# o pooler (6543) so e necessario para serverless/muitas instancias.
DATABASE_URL=postgresql://postgres:SUA_SENHA_SUPABASE@db.SEU_REF.supabase.co:5432/postgres

# Token global de API. openssl rand -hex 24
API_TOKEN=
# Assinatura dos JWT (sessao/2FA/OAuth state). MINIMO 32 chars. openssl rand -hex 32
JWT_SECRET=
# Cifra segredos sensiveis em repouso (tokens Cloud/Google, OTP). MINIMO 16 chars.
# Obrigatoria se ligar WhatsApp Evolution/Cloud. openssl rand -hex 32
# NAO troque em producao sem migrar os dados cifrados.
ENCRYPTION_KEY=

# -- CORS / dominios (producao) -----------------------------------------------
# Origem EXATA do painel (Cloudflare Pages / dominio do app), sem barra final.
ALLOWED_ORIGIN=https://painel.chaveirobot.com.br
# URL publica do backend (dominio do servico no Railway / api.SEUDOMINIO).
PUBLIC_URL=https://api.chaveirobot.com.br

# -- E-mail transacional (Resend) ⚠️ obrigatório ------------------------------
# Crie a conta em resend.com, configure DNS do dominio e gere uma API key Full.
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@chaveirobot.com.br
SUPPORT_EMAIL=suporte@chaveirobot.com.br
# URL do painel — usada nos links de verificação/magic-link enviados por e-mail.
FRONTEND_URL=https://painel.chaveirobot.com.br

# -- Pagamentos (Stripe) ⚠️ obrigatório ---------------------------------------
# sk_test_ em dev, sk_live_ em producao.
STRIPE_SECRET_KEY=sk_live_...
# Signing secret do webhook: Developers → Webhooks → endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID do plano Pro (Products → nome do plano → preco → copiar ID price_...).
STRIPE_PRICE_ID_PRO=price_...

# -- Feature flags ------------------------------------------------------------
# Ligue apos confirmar que todos os usuarios existentes tem e-mail verificado.
REQUIRE_EMAIL_VERIFICATION=false

# -- Uploads (selfies do ponto) -----------------------------------------------
# O backend grava em ./uploads (= /app/uploads no container). No Railway, monte um
# VOLUME PERSISTENTE nesse caminho para as selfies sobreviverem a deploys
# (o entrypoint ajusta a permissao do volume automaticamente).

# -- Bootstrap de admin (opcional; so roda em banco vazio) --------------------
# Cria admin + empresa na 1a subida. Troque a senha no 1o acesso.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NOME=Admin
ADMIN_EMPRESA=Minha Empresa

# -- Observabilidade (recomendado em producao) --------------------------------
SENTRY_DSN=
LOG_LEVEL=info
APP_VERSION=

# -- Login social (opcional; cada provedor liga so com a client id) -----------
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common
APPLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# WhatsApp - DESLIGADO no lancamento. NAO defina WHATSAPP_HABILITADO.
# Deixe as variaveis abaixo VAZIAS ate reativar (ver docs/LAUNCH_PLAN.md F1-3).
# -----------------------------------------------------------------------------
# WHATSAPP_HABILITADO=true
WHATSAPP_PROVIDER=evolution
BOT_INSTANCE_NAME=admai-bot
SUPER_ADMIN_USERNAME=
# Evolution API (provider=evolution)
EVOLUTION_HOST=
EVOLUTION_API_KEY=
# WhatsApp Cloud API / Meta (provider=cloud)
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# -- Google Business Profile (avaliacoes) - opcional, atras de flag -----------
GOOGLE_REVIEWS_ENABLED=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.SEUDOMINIO/api/google/oauth/callback
GOOGLE_BUSINESS_VALIDATE_ONLY=true

# -- IA (analise de avaliacoes) - opcional ------------------------------------
ANTHROPIC_API_KEY=
AI_REVIEWS_MODEL=claude-haiku-4-5

# -- Redis (rate limiting distribuido) ----------------------------------------
REDIS_URL=redis://localhost:6379