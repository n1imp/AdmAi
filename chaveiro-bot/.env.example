# ==========================================
# BANCO DE DADOS
# ==========================================
DATABASE_URL=postgresql://iago:chaveiro123@localhost:5432/chaveirobot
# ==========================================
# SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# AUTENTICAÇÃO DA API (token fixo para o painel)
# Gere um token aleatório seguro: openssl rand -hex 32
# ==========================================
API_TOKEN=318d74264f22727fa0dd4c953495b690ee92a19085b9906dd3b4797939b944a2

# ==========================================
# EVOLUTION API (WhatsApp)
# Depois de subir o docker-compose, acesse http://localhost:8080
# e crie uma instância com o nome abaixo
# ==========================================
EVOLUTION_HOST=http://localhost:8080
EVOLUTION_API_KEY=chaveiro-evolution-2024-xk9m
EVOLUTION_INSTANCE=chaveiro

# ==========================================
# WHATSAPP
# Para obter o GROUP_JID, use:
# GET http://localhost:8080/group/fetchAllGroups/chaveiro?getParticipants=false
# Headers: { apikey: sua_api_key_aqui }
# O JID estará no campo "id" do grupo desejado
# Formato: 120363xxxxxx@g.us
# ==========================================
GROUP_JID=120363xxxxxx@g.us
