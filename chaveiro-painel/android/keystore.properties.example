# Credenciais de assinatura do app Android (release).
# Copie para `keystore.properties` (mesmo diretório) e preencha. NÃO comite o arquivo
# real — ele está no .gitignore. Lido por app/build.gradle quando presente; sem ele,
# o release sai NÃO assinado (dev/CI continuam funcionando).
#
# 1) Gere o keystore de upload (uma única vez, guarde com segurança — sem ele você
#    perde a capacidade de atualizar o app na Play):
#
#    keytool -genkey -v -keystore chaveirobot-upload.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2) Aponte storeFile para o caminho do .jks (relativo à pasta android/).

storeFile=chaveirobot-upload.jks
storePassword=SENHA_DO_KEYSTORE
keyAlias=upload
keyPassword=SENHA_DA_CHAVE
