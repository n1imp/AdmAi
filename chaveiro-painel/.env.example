# -----------------------------------------------------------------------------
# ChaveiroBot - painel (.env)  |  Deploy: Cloudflare Pages (estatico)
# Variaveis VITE_* sao embutidas NO BUILD (npm run build / cap:sync). Defina-as
# ANTES de buildar. NAO comite o `.env` real. Nenhuma deve conter segredo de
# servidor (tudo aqui vai para o bundle do navegador / app).
# No Cloudflare Pages, defina-as em Settings > Environment variables (Production).
# -----------------------------------------------------------------------------

# -- API base -----------------------------------------------------------------
# Cloudflare Pages e um host ESTATICO (sem proxy nginx), entao o painel chama a API
# em outra origem -> defina a URL ABSOLUTA do backend (Railway / api.SEUDOMINIO),
# sem barra final. O CORS e liberado pelo ALLOWED_ORIGIN do backend.
# Mesmo valor serve para o app (Capacitor): $env:VITE_API_URL='...'; npm run cap:sync
# (So deixe vazio se for servir o painel atras de um proxy que exponha /api na mesma origem.)
VITE_API_URL=https://api.chaveirobot.com.br/api

# -- Observabilidade (opcional) -----------------------------------------------
# DSN do Sentry do front. Ausente = Sentry desligado.
VITE_SENTRY_DSN=

# -- Login social (opcional; cada provedor aparece so com a client id) --------
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT=common
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# -- Suporte ao cliente (Crisp Chat) ------------------------------------------
# Crie workspace em crisp.chat → copie o Website ID.
VITE_CRISP_ID=

# -- Analytics (PostHog) ------------------------------------------------------
# Projeto em posthog.com → copie a Project API Key e o Host.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com